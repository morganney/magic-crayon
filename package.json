{
  "name": "magic-crayon",
  "private": true,
  "version": "1.0.0-rc.0",
  "type": "module",
  "description": "An HTML custom element for using a crayon to draw on a canvas and serialize as a blob or data URL.",
  "types": "./dist/magic-crayon.d.ts",
  "exports": {
    ".": {
      "types": "./dist/magic-crayon.d.ts",
      "import": "./dist/magic-crayon.js"
    },
    "./defined": {
      "types": "./dist/defined.d.ts",
      "import": "./dist/defined.js"
    }
  },
  "sideEffects": [
    "./dist/defined.js"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "dev": "vite -c vite.config.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build -c vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "build:demo": "vite build -c vite.config.ts",
    "preview": "npm run build:demo && vite preview -c vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/web-components-vite": "^10.2.8",
    "@testing-library/dom": "^10.4.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-wc": "^3.1.0",
    "prettier": "^3.8.1",
    "storybook": "^10.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 90,
    "semi": false,
    "singleQuote": true
  }
}
