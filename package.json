{
  "name": "magic-crayon",
  "version": "1.0.0-rc.0",
  "type": "module",
  "description": "An HTML custom element for using a crayon to draw on a canvas and serialize as a blob or data URL.",
  "homepage": "https://github.com/morganney/magic-crayon#readme",
  "bugs": {
    "url": "https://github.com/morganney/magic-crayon/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morganney/magic-crayon"
  },
  "types": "./dist/magic-crayon.d.ts",
  "exports": {
    ".": {
      "types": "./dist/magic-crayon.d.ts",
      "import": "./dist/magic-crayon.js"
    },
    "./defined": {
      "types": "./dist/defined.d.ts",
      "import": "./dist/defined.js"
    }
  },
  "sideEffects": [
    "./dist/defined.js"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.ts",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "svg:optimize": "svgo --config=svgo.config.js --multipass --folder assets --recursive",
    "svg:check": "node ./scripts/check-svgo.js",
    "prettier": "prettier --write .",
    "dev": "vite -c vite.config.ts",
    "build": "vite build -c vite.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "preview": "npm run build && vite preview -c vite.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "prepare": "husky",
    "prepack": "npm run build"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,html,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.1",
    "@html-eslint/eslint-plugin": "^0.55.0",
    "@storybook/web-components-vite": "^10.2.8",
    "@testing-library/dom": "^10.4.1",
    "@types/clean-css": "^4.2.11",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.10.13",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "clean-css": "^5.3.3",
    "eslint": "^9.39.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unicorn": "^61.0.2",
    "eslint-plugin-wc": "^3.1.0",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.1",
    "prettier": "^3.8.1",
    "storybook": "^10.2.13",
    "svgo": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 90,
    "semi": false,
    "singleQuote": true
  }
}
